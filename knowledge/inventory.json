    {
      "id": "mithril",
      "name": "Mithril",
      "summary": "A rare silvery metal that infuses Hero Gear with extraordinary power.",
      "details": {
        "category": "resource",
        "overview": "Mithril is a rare item required for upgrading Red Hero Gears in Kingshot. Once a Mythic Gear hits level 100 and has Mastery Forging level 10, you can turn it into Red Gear by merging it with two other Mythic Gears. After that, you can keep leveling up the Red Gear another 100 levels. You'll need Mithril for a special upgrade every 20 levels (i.e, levels 20, 40, 60, 80, and 100).",
        "sources": [
          "Arena Shop",
          "Champagne Fair"
        ],
        "requirements": [
          {
            "level": "+1",
            "mithril": null,
            "additional_info": "2 Mythic Gears"
          },
          {
            "level": "+20",
            "mithril": 10,
            "additional_info": "3 Mythic Gears"
          },
          {
            "level": "+40",
            "mithril": 20,
            "additional_info": "5 Mythic Gears"
          },
          {
            "level": "+60",
            "mithril": 30,
            "additional_info": "5 Mythic Gears"
          },
          {
            "level": "+80",
            "mithril": 40,
            "additional_info": "10 Mythic Gears"
          },
          {
            "level": "+100",
            "mithril": 50,
            "additional_info": "10 Mythic Gears"
          }
        ],
        "related_info": "The safest Mithril plan is to decide before a gear or KvK event window. Red gear upgrades are powerful, but Mithril is scarce enough that spending it without checking the next governor gear, hero gear, or scoring breakpoint can slow the rest of your account."
      },
      "tags": [
        "item",
        "resource",
        "hero-gear",
        "red-gear",
        "mythic"
      ]
    },
