    {
      "id": "general-master-emblem",
      "name": "General Master Emblem",
      "summary": "A key planning material for Kingshot Master upgrades and Master Academy progression.",
      "details": {
        "category": "resource",
        "overview": "General Master Emblem is the material players should track before committing to Master upgrades. Because Master pages and Master Academy timing can vary by kingdom and event rotation, the safest approach is to model your weekly income, target window, and priority Master before spending.",
        "sources": [
          "Master Academy activity windows",
          "Elysium Shop rotation",
          "Limited-time event shops",
          "Value packs and bundles"
        ],
        "requirements": [
          {
            "purpose": "Planning reserve",
            "amount_required": "Track weekly income",
            "additional_info": "Use the Master Upgrade Planner before spending so you can compare current stock, expected income, and the next push window."
          },
          {
            "purpose": "Upgrade push",
            "amount_required": "Confirm in game",
            "additional_info": "Exact costs can change by Master and kingdom state, so use this item page as a planning hub rather than a fixed cost table."
          }
        ],
        "related_info": "Recommended internal workflow: check your kingdom age, compare Master pages for Pan, Valora, and Roman, then use the Master Upgrade Planner to decide whether to spend now or hold for the next event cycle."
      },
      "tags": [
        "item",
        "resource",
        "master",
        "master-academy",
        "planning"
      ]
    },
