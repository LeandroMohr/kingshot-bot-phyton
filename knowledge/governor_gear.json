      "id": "fundamentals",
      "name": "Governor Gear fundamentals",
      "summary": "Governor Gear unlocks at Town Center level 22 and allows up to six permanent gear pieces: two each for infantry, cavalry, and archers. Each piece gives standardized attack and defense for its troop type. It has no unique abilities, cannot be downgraded, and all pieces of the same type and level give identical stats. Bonuses apply GLOBALLY across all marches.",
      "details": {
        "unlock_requirement": "Town Center level 22",
        "piece_count": {
          "total": 6,
          "per_troop_type": 2,
          "troop_types": [
            "infantry",
            "cavalry",
            "archer"
          ]
        },
        "stat_type": "attack and defense (per troop type)",
        "scope": "Global: applies to every march, unlike single-march bonuses (heroes, hero gear).",
        "set_bonuses": "Set bonuses activate at 3 and at 6 pieces of the same gear level.",
        "materials": [
          "satin",
          "gilded_threads",
          "artisans_vision"
        ],
        "cost_shape": "Non-linear: diminishing returns, plus points where a higher tier costs less than a prior upgrade -> creates specific efficiency breakpoints.",
        "tier_gating": "Additional tiers unlock as the kingdom ages, but most players are material-limited before hitting that cap.",
        "role": "A slow, durable backbone of account power. Reaches diminishing returns faster than research/pets/hero gear/charms, so it complements higher-ROI systems rather than replacing them.",
        "rising_value": "As multi-march game modes grow, its global bonus gains relative value versus single-march systems."
      },
      "tags": [
